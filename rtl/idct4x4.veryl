interface Idct4x4If {
    var coeff_ready: bool       ;
    var coeff_valid: bool       ;
    var coeff      : i16  [4, 4];

    var block_ready: bool       ;
    var block_valid: bool       ;
    var block      : i16  [4, 4];

    modport self {
        coeff_ready: output,
        coeff_valid: input ,
        coeff      : input ,

        block_ready: input ,
        block_valid: output,
        block      : output,
    }

    modport user {
        coeff_ready: input ,
        coeff_valid: output,
        coeff      : output,

        block_ready: output,
        block_valid: input ,
        block      : input ,
    }
}

module Idct4x4 (
    clk: input clock,
    rst: input reset,

    self: modport Idct4x4If::self,
) {
    let cospi8sqrt2minus1: signed logic<32> = 20091;
    let sinpi8sqrt2      : signed logic<32> = 35468;

    #[enum_encoding(onehot)]
    enum State {
        idle,
        calc_cols,
        calc_rows,
        out,
    }

    var state: State   ;
    var i    : logic<2>;

    // TODO: this can be further optimized in terms of area
    always_ff {
        if_reset {
            state      = State::idle;
            self.block = '{default: '{default: 0}};
            i          = 0;
        } else {
            case state {
                default    : state = State::idle;
                State::idle: {
                    if self.coeff_valid {
                        state      = State::calc_cols;
                        i          = 0;
                        self.block = self.coeff;
                    }
                }
                State::calc_cols: {
                    i += 1;
                    if i == 3 {
                        state = State::calc_rows;
                    }

                    let a1: i32 = self.block[0][i] as i32 + self.block[2][i] as i32;
                    let b1: i32 = self.block[0][i] as i32 - self.block[2][i] as i32;

                    let t1: i32 = (self.block[1][i] as i32 * sinpi8sqrt2) >>> 16;
                    let t2: i32 = self.block[3][i] as i32 + ((self.block[3][i] as i32 * cospi8sqrt2minus1) >>> 16);
                    let c1: i32 = t1 - t2;

                    let t3: i32 = self.block[1][i] as i32 + ((self.block[1][i] as i32 * cospi8sqrt2minus1) >>> 16);
                    let t4: i32 = (self.block[3][i] as i32 * sinpi8sqrt2) >>> 16;
                    let d1: i32 = t3 + t4;

                    self.block[0][i] = (a1 + d1) as i16;
                    self.block[1][i] = (b1 + c1) as i16;
                    self.block[3][i] = (a1 - d1) as i16;
                    self.block[2][i] = (b1 - c1) as i16;
                }
                State::calc_rows: {
                    i += 1;
                    if i == 3 {
                        state = State::out;
                    }

                    let a1: i32 = self.block[i][0] as i32 + self.block[i][2] as i32;
                    let b1: i32 = self.block[i][0] as i32 - self.block[i][2] as i32;

                    let t1: i32 = (self.block[i][1] as i32 * sinpi8sqrt2) >>> 16;
                    let t2: i32 = self.block[i][3] as i32 + ((self.block[i][3] as i32 * cospi8sqrt2minus1) >>> 16);
                    let c1: i32 = t1 - t2;

                    let t3: i32 = self.block[i][1] as i32 + ((self.block[i][1] as i32 * cospi8sqrt2minus1) >>> 16);
                    let t4: i32 = (self.block[i][3] as i32 * sinpi8sqrt2) >>> 16;
                    let d1: i32 = t3 + t4;

                    self.block[i][0] = ((a1 + d1 + 4) >>> 3) as i16;
                    self.block[i][3] = ((a1 - d1 + 4) >>> 3) as i16;
                    self.block[i][1] = ((b1 + c1 + 4) >>> 3) as i16;
                    self.block[i][2] = ((b1 - c1 + 4) >>> 3) as i16;
                }

                State::out: {
                    if self.block_ready {
                        state = State::idle;
                    }
                }
            }
        }
    }

    always_comb {
        self.block_valid = false;
        self.coeff_ready = false;

        case state {
            default    : {}
            State::idle: {
                self.coeff_ready = true;
            }
            State::out: {
                self.block_valid = true;
            }
        }
    }

}

module Iwht4x4 (
    clk: input clock,
    rst: input reset,

    self: modport Idct4x4If::self,
) {
    #[enum_encoding(onehot)]
    enum State {
        idle,
        calc_cols,
        calc_rows,
        out,
    }

    var state: State   ;
    var i    : logic<2>;

    // TODO: this can be further optimized in terms of area
    always_ff {
        if_reset {
            state      = State::idle;
            self.block = '{default: '{default: 0}};
            i          = 0;
        } else {
            case state {
                default    : state = State::idle;
                State::idle: {
                    if self.coeff_valid {
                        state      = State::calc_cols;
                        i          = 0;
                        self.block = self.coeff;
                    }
                }
                State::calc_cols: {
                    i += 1;
                    if i == 3 {
                        state = State::calc_rows;
                    }

                    let a1: i32 = self.block[0][i] as i32 + self.block[3][i] as i32;
                    let b1: i32 = self.block[1][i] as i32 + self.block[2][i] as i32;
                    let c1: i32 = self.block[1][i] as i32 - self.block[2][i] as i32;
                    let d1: i32 = self.block[0][i] as i32 - self.block[3][i] as i32;

                    self.block[0][i] = (a1 + b1) as i16;
                    self.block[1][i] = (c1 + d1) as i16;
                    self.block[2][i] = (a1 - b1) as i16;
                    self.block[3][i] = (d1 - c1) as i16;
                }
                State::calc_rows: {
                    i += 1;
                    if i == 3 {
                        state = State::out;
                    }

                    let a1: i32 = self.block[i][0] as i32 + self.block[i][3] as i32;
                    let b1: i32 = self.block[i][1] as i32 + self.block[i][2] as i32;
                    let c1: i32 = self.block[i][1] as i32 - self.block[i][2] as i32;
                    let d1: i32 = self.block[i][0] as i32 - self.block[i][3] as i32;

                    let a2: i32 = a1 + b1;
                    let b2: i32 = c1 + d1;
                    let c2: i32 = a1 - b1;
                    let d2: i32 = d1 - c1;

                    self.block[i][0] = ((a2 + 3) >>> 3) as i16;
                    self.block[i][1] = ((b2 + 3) >>> 3) as i16;
                    self.block[i][2] = ((c2 + 3) >>> 3) as i16;
                    self.block[i][3] = ((d2 + 3) >>> 3) as i16;
                }

                State::out: {
                    if self.block_ready {
                        state = State::idle;
                    }
                }
            }
        }
    }

    always_comb {
        self.block_valid = false;
        self.coeff_ready = false;

        case state {
            default    : {}
            State::idle: {
                self.coeff_ready = true;
            }
            State::out: {
                self.block_valid = true;
            }
        }
    }

}

module Idct4x4Test (
    clk: input clock,
    rst: input reset,

    dct_or_wht: input logic,

    coeff_ready: output bool       ,
    coeff_valid: input  bool       ,
    coeff      : input  i16  [4, 4],

    block_ready: input  bool       ,
    block_valid: output bool       ,
    block      : output i16  [4, 4],
) {
    inst bus: Idct4x4If [2];

    inst dct: Idct4x4 (
        clk         ,
        rst         ,
        self: bus[0],
    );

    inst wht: Iwht4x4 (
        clk         ,
        rst         ,
        self: bus[1],
    );

    always_comb {
        bus[0].coeff_valid = false;
        bus[0].block_ready = false;
        bus[0].coeff       = '{default: '{default: 0}};

        bus[1].coeff_valid = false;
        bus[1].block_ready = false;
        bus[1].coeff       = '{default: '{default: 0}};

        coeff_ready = false;
        block_valid = false;
        block       = '{default: '{default: 0}};

        case dct_or_wht {
            0: {
                bus[0].coeff_valid = coeff_valid;
                bus[0].block_ready = block_ready;
                bus[0].coeff       = coeff;

                coeff_ready = bus[0].coeff_ready;
                block_valid = bus[0].block_valid;
                block       = bus[0].block;
            }
            1: {
                bus[1].coeff_valid = coeff_valid;
                bus[1].block_ready = block_ready;
                bus[1].coeff       = coeff;

                coeff_ready = bus[1].coeff_ready;
                block_valid = bus[1].block_valid;
                block       = bus[1].block;
            }
        }
    }
}

#[test(test_idct4x4, Idct4x4Test)]
include (cocotb, "test/idct4x4.py");
