package MacroblockHeaderPkg {
    enum IntraMBMode {
        DcPred, /* predict DC using row above and column to the left */
        VPred, /* predict rows using row above */
        HPred, /* predict columns using column to the left */
        TmPred, /* propagate second differences a la "True Motion" */
        BPred, /* each Y subblock is independently predicted */
    }

    enum IntraBMode {
        BDcPred, /* predict DC using row above and column to the left */
        BTmPred, /* propagate second differences a la "True Motion" */
        BVePred, /* predict rows using row above */
        BHePred, /* predict columns using column to the left */
        BLdPred, /* southwest (left and down) 45 degree diagonal prediction */
        BRdPred, /* southeast (right and down) "" */
        BVrPred, /* SSE (vertical right) diagonal prediction */
        BVlPred, /* SSW (vertical left) "" */
        BHdPred, /* ESE (horizontal down) "" */
        BHuPred, /* ENE (horizontal up) "" */
    }

    type SubModes = IntraBMode<4, 4>;

    struct MacroblockHeader {
        valid        : bool       ,
        mb_skip_coeff: bool       ,
        intra_y_mode : IntraMBMode,
        sub_modes    : SubModes   ,
        intra_uv_mode: IntraMBMode,
    }

    const KF_YMODE_PROB  : u8 [4] = '{145, 156, 163, 128};
    const KF_UV_MODE_PROB: u8 [3] = '{142, 114, 183};

    // Trees are represented as flat arrays
    // postive values are offsets to the next node
    // negative values are the leaf values (modes)
    // we use 8 bits signed integers
    const KF_YMODE_TREE: i8 [8] = '{
        -(IntraMBMode::DcPred as i8), 2, 4, 6,
        -(IntraMBMode::VPred as i8),
        -(IntraMBMode::HPred as i8),
        -(IntraMBMode::TmPred as i8),
        -(IntraMBMode::BPred as i8)
    };

    const UV_MODE_TREE: i8 [6] = '{
        -(IntraMBMode::DcPred as i8), 2,
        -(IntraMBMode::VPred as i8), 4,
        -(IntraMBMode::HPred as i8),
        -(IntraMBMode::TmPred as i8)
    };

    const BMODE_TREE: i8 [18] = '{
        -(IntraBMode::BDcPred as i8), 2,
        -(IntraBMode::BTmPred as i8), 4,
        -(IntraBMode::BVePred as i8), 6, 8, 12,
        -(IntraBMode::BHePred as i8), 10,
        -(IntraBMode::BRdPred as i8),
        -(IntraBMode::BVrPred as i8),
        -(IntraBMode::BLdPred as i8), 14,
        -(IntraBMode::BVlPred as i8), 16,
        -(IntraBMode::BHdPred as i8),
        -(IntraBMode::BHuPred as i8)
    };

}
